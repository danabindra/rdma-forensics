        <mxCell id="fleet" value="&lt;b&gt;FULL CLUSTER&lt;/b&gt;&lt;br/&gt;8 groups/racks × 8 nodes each&lt;br/&gt;Each node: 8 GPUs + 8 NICs&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Total:&lt;/b&gt; 64 nodes | 512 GPUs | 512 NICs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EEF3;strokeColor=#90A4AE;fontSize=12;align=left;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="630" y="165" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;MODEL / CACHE STORAGE&lt;/b&gt;&lt;br/&gt;Weights, tokenizer/config, embeddings, artifacts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E9A23B;strokeColor=#B87516;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="650" y="360" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="storlink" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E9A23B;strokeWidth=2;dashed=1;endArrow=block;" parent="1" edge="1" source="storage" target="node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="optbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFCFD;strokeColor=#C95C54;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="910" y="165" width="630" height="610" as="geometry" />
        </mxCell>
        <mxCell id="opth" value="WHAT THE ARCHITECT OPTIMIZES" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#16324F;align=left;" parent="1" vertex="1">
          <mxGeometry x="935" y="185" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="o0" value="&lt;b&gt;GPU / HBM&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Fit model weights plus KV cache; optimize memory capacity, locality and utilization under variable demand.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="230" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Scale-up&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Keep tensor-parallel groups local when possible; optimize latency more than cluster-wide bandwidth.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="288" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;GPU ↔ NIC&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Fast request/model traffic; direct DMA matters when inference spans nodes or accesses remote caches/storage.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="346" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;Leaf&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Prioritize predictable latency, queue isolation and failure-domain placement; backend may be less saturated.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="404" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;Spine / Clos&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Size from actual cross-node model parallelism and east-west demand; identical training bandwidth may be wasteful.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="462" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;RoCE / RDMA&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Needed for cross-node tensor/pipeline/expert parallelism; focus on tail latency, queueing and congestion isolation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="520" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Fast model loading/warm-up and artifact distribution; less continuous dataset streaming than training.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="578" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o7" value="&lt;b&gt;Serving&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;Replicas, load balancing, batching, autoscaling, health draining and tenant/SLO isolation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="636" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o8" value="&lt;b&gt;Primary KPIs&lt;/b&gt;&lt;br/&gt;&lt;font size=&quot;2&quot;&gt;TTFT, inter-token latency, p95/p99 latency, tokens/sec, concurrency, KV-cache hit/use, availability.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;" parent="1" vertex="1">
          <mxGeometry x="935" y="694" width="575" height="52" as="geometry" />
        </mxCell>
        <mxCell id="flow" value="&lt;b&gt;Dominant communication pattern:&lt;/b&gt; request → serving replica → smallest practical GPU group → response; cross-node fabric use depends on model parallelism." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEEE;strokeColor=#C95C54;fontSize=13;align=center;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="815" width="1500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tenant" value="&lt;b&gt;Multi-tenancy:&lt;/b&gt; isolate customer/front-end networks with VRF/VXLAN/EVPN or equivalent policy constructs. Treat backend RDMA isolation/QoS as a separate design problem; do not assume ordinary overlay segmentation alone guarantees performance isolation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6A84B;fontSize=11;align=left;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="890" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vn" value="&lt;b&gt;Vendor-neutral:&lt;/b&gt; “scale-up fabric,” “direct device-memory DMA,” and “direct-to-GPU storage I/O” are architectural capabilities. Product implementations vary by GPU, NIC, switch, storage, and software stack." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;fontSize=10;align=left;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="965" width="1500" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
