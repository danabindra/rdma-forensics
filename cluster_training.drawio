        <mxCell id="o0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;GPU / HBM&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Maximize utilization; feed every GPU; minimize stalls during forward/backward passes.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="230" as="geometry" />
        </mxCell>
        <mxCell id="o1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;Scale-up&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;High bandwidth for intra-node collectives; topology-aware GPU placement.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="288" as="geometry" />
        </mxCell>
        <mxCell id="o2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;GPU ↔ NIC&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Preserve GPU/NIC affinity; direct device-memory DMA where supported; avoid NUMA/PCIe detours.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="346" as="geometry" />
        </mxCell>
        <mxCell id="o3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;Leaf / Rail&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Rail-aware placement; balanced hashing; enough downlink/uplink capacity for synchronized bursts.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="404" as="geometry" />
        </mxCell>
        <mxCell id="o4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;Spine / Clos&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;High bisection bandwidth, ideally nonblocking/low oversubscription; many equal-cost paths.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="462" as="geometry" />
        </mxCell>
        <mxCell id="o5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;RoCE / RDMA&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Tune ECN/congestion control, QoS and PFC where required; watch incast, hotspots, retransmits.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="520" as="geometry" />
        </mxCell>
        <mxCell id="o6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Sustain dataset reads and bursty checkpoint writes; parallel I/O, caching/prefetch, direct-to-GPU I/O where supported.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="578" as="geometry" />
        </mxCell>
        <mxCell id="o7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Topology-aware gang scheduling: keep large jobs close and preserve rail/failure-domain symmetry.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="636" as="geometry" />
        </mxCell>
        <mxCell id="o8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFD8DC;fontSize=11;align=left;verticalAlign=middle;spacing=7;fontFamily=Comic Sans MS;" value="&lt;b&gt;Primary KPIs&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;GPU utilization, collective latency/bandwidth, fabric utilization, job step time, checkpoint duration.&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="575" x="935" y="694" as="geometry" />
        </mxCell>
        <mxCell id="tenant" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacing=8;fontFamily=Comic Sans MS;fillStyle=dots;strokeColor=none;fontColor=light-dark(#e2b1b1, #ededed);" value="&lt;b&gt;Design Notes&lt;br&gt;&lt;br&gt;Multi-tenancy:&lt;/b&gt; isolate customer/front-end networks with VRF/VXLAN/EVPN or equivalent policy constructs. Treat backend RDMA isolation/QoS as a separate design problem; do not assume ordinary overlay segmentation alone guarantees performance isolation.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;Vendor-neutral:&lt;/b&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt; “scale-up fabric,” “direct device-memory DMA,” and “direct-to-GPU storage I/O” are architectural capabilities. Product implementations vary by GPU, NIC, switch, storage, and software stack.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="492.5" x="40" y="840" as="geometry" />
        </mxCell>
        <mxCell id="scale" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE8F7;strokeColor=#735DA5;fontSize=7;fontFamily=Comic Sans MS;" value="SCALE-UP GPU FABRIC&lt;br&gt;&lt;font&gt;Vendor-neutral concept: high-bandwidth GPU↔GPU domain&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="450" x="100" y="430" as="geometry" />
